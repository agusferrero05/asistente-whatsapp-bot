# ----------------------------------------------------------------------------
# EVOLUTION API (WhatsApp self-hosted)
# ----------------------------------------------------------------------------
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=cambia-esta-clave-por-una-segura
EVOLUTION_INSTANCE_NAME=mi-asistente
# Número al que el bot puede responder (el tuyo). Formato: 549XXXXXXXXXX
# OJO: para Argentina normalmente lleva el 9 después del 54 (confirmalo mirando
# el "remoteJid" en los logs de evolution-api la primera vez que te escribas).
MY_WHATSAPP_NUMBER=5493400000000

# ----------------------------------------------------------------------------
# GEMINI (cerebro del agente: razonamiento + function calling)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# ----------------------------------------------------------------------------
# GROQ (se mantiene solo para transcribir audio con Whisper; el texto
# resultante se lo pasamos a Gemini igual que un mensaje de texto normal)
# ----------------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ----------------------------------------------------------------------------
# GOOGLE (Calendar + Sheets) - OAuth2 de tu cuenta personal
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Se genera automáticamente la primera vez que corrés `npm run auth:google`
GOOGLE_REFRESH_TOKEN=

GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEET_ID=pega-aqui-el-id-de-tu-hoja-de-calculo

# ----------------------------------------------------------------------------
# SCHEDULER
# ----------------------------------------------------------------------------
CRON_RESUMEN_DIARIO=0 8 * * *
CRON_RESUMEN_SEMANAL=0 9 * * 1
# Chequeo de recordatorios próximos (cada 5 min, avisa eventos que arrancan en <=15 min)
CRON_CHEQUEO_EVENTOS=*/5 * * * *
TIMEZONE=America/Argentina/Buenos_Aires

# ----------------------------------------------------------------------------
# SERVIDOR
# ----------------------------------------------------------------------------
PORT=3000
